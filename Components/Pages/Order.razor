@page "/order"
@inject CartState Cart

<PageTitle>Your order · Blazing Pizza</PageTitle>

<section class="order-page">
    <div class="order-heading"><span class="eyebrow">YOUR BLAZING MOMENT</span><h1>Your order.</h1><p>Freshly made, just the way you like it.</p></div>
    @if (Cart.Items.Count == 0)
    {
        <div class="empty-cart"><span>🍕</span><h2>Your box is waiting.</h2><p>Pick a pizza and we’ll get the oven going.</p><NavLink class="button button-dark" href="/menu">Browse the menu <span>→</span></NavLink></div>
    }
    else
    {
        <div class="order-layout">
            <div class="order-items">
                @foreach (var item in Cart.Items)
                {
                    <article class="order-item">
                        <span class="order-emoji @item.Pizza.ArtClass">@item.Pizza.Emoji</span>
                        <div class="order-item-info"><h3>@item.Pizza.Name</h3><p>@item.Pizza.Description</p><strong>@PriceFormatter.Format(item.Pizza.Price)</strong></div>
                        <div class="quantity-control"><button @onclick="() => Cart.RemoveOne(item.Pizza.Id)" aria-label="Remove one @item.Pizza.Name">−</button><span>@item.Quantity</span><button @onclick="() => Cart.Add(item.Pizza)" aria-label="Add one @item.Pizza.Name">＋</button></div>
                    </article>
                }
                <NavLink class="continue-link" href="/menu">← Add another pizza</NavLink>
            </div>
            <aside class="order-summary"><span class="eyebrow">THE TOTAL</span><div class="summary-line"><span>Subtotal</span><strong>@PriceFormatter.Format(Cart.Subtotal)</strong></div><div class="summary-line"><span>Delivery</span><strong>Free</strong></div><div class="summary-total"><span>Total</span><strong>@PriceFormatter.Format(Cart.Subtotal)</strong></div><p class="currency-note">All prices in CFA francs (XOF).</p><button class="button button-dark checkout-button" @onclick="PlaceOrder">Place your order <span>→</span></button>@if (OrderPlaced) { <p class="order-confirmation" role="status">Thanks! Your demo order is ready. 🍕</p> }</aside>
        </div>
    }
</section>

@code {
    private bool OrderPlaced { get; set; }
    private void PlaceOrder() { OrderPlaced = true; Cart.Clear(); }
}
