@inherits LayoutComponentBase
@implements IDisposable
@inject CartState Cart

<div class="site-shell">
    <header class="site-header">
        <a class="brand" href="/" aria-label="Blazing Pizza home">
            <span class="brand-mark">🔥</span>
            <span>Blazing<span class="brand-accent">Pizza</span><small>FRESH FROM THE OVEN</small></span>
        </a>
        <nav class="main-nav" aria-label="Main navigation">
            <NavLink href="/" Match="NavLinkMatch.All">Home</NavLink>
            <NavLink href="/menu">Our menu</NavLink>
        </nav>
        <NavLink class="cart-link" href="/order" aria-label="View your order">
            <span>🛍️</span><span class="cart-label">Your order</span><span class="cart-count">@Cart.ItemCount</span>
        </NavLink>
    </header>
    <main>@Body</main>
    <footer class="site-footer">
        <div class="footer-brand"><span class="brand-mark">🔥</span> Blazing Pizza</div>
        <p>Made fresh, shared with joy.</p>
        <p class="student-credit">Created by <strong>Essodong N'GNAMA</strong> · <strong>Togo</strong></p>
        <small>© 2026 Blazing Pizza · Prices shown in FCFA (XOF)</small>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Something went wrong. <a href="." class="reload">Reload</a>
    <button class="dismiss" aria-label="Dismiss">×</button>
</div>

@code {
    protected override void OnInitialized() => Cart.Changed += OnCartChanged;
    private void OnCartChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Cart.Changed -= OnCartChanged;
}
